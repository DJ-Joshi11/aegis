diff --git a/src/main/resources/templates/evidence/records.html b/src/main/resources/templates/evidence/records.html
new file mode 100644
index 0000000..fcba0c3
--- /dev/null
+++ b/src/main/resources/templates/evidence/records.html
@@ -0,0 +1,207 @@
+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8"/>
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+    <title>AEGIS — Audit Evidence</title>
+    <link rel="stylesheet" th:href="@{/css/aegis.css}"/>
+    <style>
+        /* Page-scoped styling only — shared aegis.css stays untouched. */
+        .section-header {
+            display: flex;
+            align-items: baseline;
+            justify-content: space-between;
+            gap: 1rem;
+            flex-wrap: wrap;
+            margin-top: 2.5rem;
+        }
+        .section-header:first-of-type { margin-top: 0; }
+        .feed-status {
+            font-size: 0.85rem;
+            color: #5a5f7a;
+        }
+        .feed-status .dot {
+            display: inline-block;
+            width: 0.5rem;
+            height: 0.5rem;
+            border-radius: 50%;
+            background: #34c77b;
+            margin-right: 0.4rem;
+        }
+        .gap-pill {
+            display: inline-block;
+            padding: 0.15rem 0.6rem;
+            border-radius: 999px;
+            font-size: 0.78rem;
+            font-weight: 600;
+        }
+        .gap-pill.gap { background: #fde8e8; color: #a83232; }
+        .gap-pill.flagged { background: #eef0fa; color: #3d4270; }
+        .category-cell { font-weight: 600; }
+        .rate-cell { font-variant-numeric: tabular-nums; }
+        .empty-row td { text-align: center; color: #8a8fa3; padding: 2rem 0; }
+        .disclaimer {
+            margin-top: 0.75rem;
+            font-size: 0.85rem;
+            color: #5a5f7a;
+            background: #f7f8fb;
+            border-radius: 6px;
+            padding: 0.75rem 0.9rem;
+        }
+        .export-link {
+            display: inline-block;
+            margin-top: 0.5rem;
+            font-size: 0.86rem;
+        }
+    </style>
+</head>
+<body>
+<div th:replace="~{layout :: nav}"></div>
+
+<main class="aegis-content">
+    <h1>Audit Evidence</h1>
+    <p>
+        Every audit evidence record AEGIS has produced — either because
+        detection flagged a decision, or because no review arrived within
+        the review window — mapped to a broad insurance exposure category,
+        plus the exposure summary each agent's own track record produces.
+    </p>
+    <p class="disclaimer">
+        <strong>What this is not:</strong> this page does not certify
+        compliance, make a legal coverage determination, or set a premium.
+        Every row here is evidence for a human compliance or underwriting
+        reviewer to act on.
+    </p>
+    <a class="export-link" th:href="@{/api/evidence/export}">Export audit evidence (JSON) &#8594;</a>
+
+    <div class="section-header">
+        <h2>Evidence records</h2>
+        <span class="feed-status" id="evidence-status"><span class="dot"></span>Live — updates every few seconds</span>
+    </div>
+    <table id="evidence-table">
+        <thead>
+        <tr>
+            <th>Decision ID</th>
+            <th>Agent</th>
+            <th>Exposure category</th>
+            <th>Source</th>
+            <th>Reason</th>
+            <th>Time</th>
+        </tr>
+        </thead>
+        <tbody id="evidence-table-body">
+        <tr th:if="${#lists.isEmpty(evidence)}" class="empty-row">
+            <td colspan="6">No evidence recorded yet.</td>
+        </tr>
+        <tr th:each="e : ${evidence}">
+            <td th:text="${e.decisionId}"></td>
+            <td th:text="${e.agentId}"></td>
+            <td class="category-cell" th:text="${e.exposureCategory}"></td>
+            <td>
+                <span th:if="${e.controlGapIdentified}" class="gap-pill gap">Review gap</span>
+                <span th:unless="${e.controlGapIdentified}" class="gap-pill flagged">Flagged</span>
+            </td>
+            <td th:text="${e.reason}"></td>
+            <td th:text="${e.recordedAt}"></td>
+        </tr>
+        </tbody>
+    </table>
+
+    <div class="section-header">
+        <h2>Exposure summary by agent</h2>
+    </div>
+    <p>Informational only — see the project README's USP section. Not a premium, a coverage term, or a compliance certification.</p>
+    <table id="exposure-table">
+        <thead>
+        <tr>
+            <th>Agent</th>
+            <th>Decisions seen</th>
+            <th>Evidence records</th>
+            <th>Evidence rate</th>
+            <th>Dominant exposure category</th>
+        </tr>
+        </thead>
+        <tbody id="exposure-table-body">
+        <tr th:if="${#lists.isEmpty(exposureSummary)}" class="empty-row">
+            <td colspan="5">No agent data yet.</td>
+        </tr>
+        <tr th:each="s : ${exposureSummary}">
+            <td th:text="${s.agentId}"></td>
+            <td th:text="${s.totalDecisions}"></td>
+            <td th:text="${s.evidenceCount}"></td>
+            <td class="rate-cell" th:text="${#numbers.formatPercent(s.evidenceRate, 1, 0)}"></td>
+            <td th:text="${s.dominantExposureCategory}"></td>
+        </tr>
+        </tbody>
+    </table>
+</main>
+
+<div th:replace="~{layout :: footer}"></div>
+
+<script th:inline="none">
+    // Polls the evidence REST API and re-renders both tables — same pattern
+    // as the ingestion decision-feed page.
+    const POLL_INTERVAL_MS = 4000;
+    const evidenceBody = document.getElementById('evidence-table-body');
+    const exposureBody = document.getElementById('exposure-table-body');
+    const status = document.getElementById('evidence-status');
+
+    function escapeHtml(value) {
+        const div = document.createElement('div');
+        div.textContent = value == null ? '' : String(value);
+        return div.innerHTML;
+    }
+
+    function renderEvidence(evidence) {
+        if (!evidence || evidence.length === 0) {
+            evidenceBody.innerHTML = '<tr class="empty-row"><td colspan="6">No evidence recorded yet.</td></tr>';
+            return;
+        }
+        evidenceBody.innerHTML = evidence.map(function (e) {
+            const pill = e.controlGapIdentified
+                ? '<span class="gap-pill gap">Review gap</span>'
+                : '<span class="gap-pill flagged">Flagged</span>';
+            return '<tr>'
+                + '<td>' + escapeHtml(e.decisionId) + '</td>'
+                + '<td>' + escapeHtml(e.agentId) + '</td>'
+                + '<td class="category-cell">' + escapeHtml(e.exposureCategory) + '</td>'
+                + '<td>' + pill + '</td>'
+                + '<td>' + escapeHtml(e.reason) + '</td>'
+                + '<td>' + escapeHtml(e.recordedAt) + '</td>'
+                + '</tr>';
+        }).join('');
+    }
+
+    function renderExposureSummary(summary) {
+        if (!summary || summary.length === 0) {
+            exposureBody.innerHTML = '<tr class="empty-row"><td colspan="5">No agent data yet.</td></tr>';
+            return;
+        }
+        exposureBody.innerHTML = summary.map(function (s) {
+            return '<tr>'
+                + '<td>' + escapeHtml(s.agentId) + '</td>'
+                + '<td>' + escapeHtml(s.totalDecisions) + '</td>'
+                + '<td>' + escapeHtml(s.evidenceCount) + '</td>'
+                + '<td class="rate-cell">' + Math.round(s.evidenceRate * 100) + '%</td>'
+                + '<td>' + escapeHtml(s.dominantExposureCategory) + '</td>'
+                + '</tr>';
+        }).join('');
+    }
+
+    function refresh() {
+        Promise.all([
+            fetch('/api/evidence').then(function (res) { return res.json(); }),
+            fetch('/api/exposure-summary').then(function (res) { return res.json(); })
+        ]).then(function (results) {
+            renderEvidence(results[0]);
+            renderExposureSummary(results[1]);
+            status.innerHTML = '<span class="dot"></span>Live — last updated ' + new Date().toLocaleTimeString();
+        }).catch(function () {
+            status.textContent = 'Live updates paused — retrying...';
+        });
+    }
+
+    setInterval(refresh, POLL_INTERVAL_MS);
+</script>
+</body>
+</html>
