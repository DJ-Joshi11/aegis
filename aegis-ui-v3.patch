+/* Stage 02 · Detection & Compliance */
+(function () {
+    'use strict';
+    var A = window.AEGIS, $ = A.$, $$ = A.$$;
+    var HEX = A.STAGES.detection.hex;
+    var PROD = { thr: 50, min: 5 };
