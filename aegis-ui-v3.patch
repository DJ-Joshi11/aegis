+                        </div>
+                    </div>
+                </div>
+            </div>
+
+            <div class="card mt-14" id="queue-card">
+                <div class="card-h">
+                    <h3>Flag queue</h3><span class="sub">what a compliance reviewer works through</span>
+                    <div class="right">
+                        <div class="seg" id="rule-seg"><button data-r="" class="on">All</button><button data-r="fraud">Fraud rule</button><button data-r="outlier">Outlier rule</button></div>
+                        <span class="mini-pill" id="q-count">0</span>
+                    </div>
+                </div>
+                <div class="table-wrap">
+                    <table class="t">
+                        <thead><tr><th>Reason flagged</th><th>Rule</th><th>Compliance tag</th><th>Qusar agent</th><th>Decision</th><th>Outcome</th><th>Jurisdiction</th><th>Reviewed</th></tr></thead>
+                        <tbody id="rows"></tbody>
+                    </table>
+                </div>
+            </div>
+
+        </main>
+    </div>
+</div>
